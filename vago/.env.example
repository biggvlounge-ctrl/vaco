PORT=8795
# Real VCoin movement (sportsbook stakes, esports stakes, VCoin-currency
# casino sessions) routes through V3's /api/vcoin/transfer --
# venvs-mock-backend stands in for the real V3 ledger in this
# environment (see that project's own README for the same caveat).
#
# Gold Coin is a genuinely separate, non-redeemable, VAGO-only ledger
# and deliberately does NOT route through V3_API_URL -- there is no
# code path anywhere in this project that converts between Gold Coin
# and VCoin, in either direction. That absence is the compliance
# enforcement, not a TODO.
V3_API_URL=http://localhost:8811
