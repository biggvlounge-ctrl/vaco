# VACO on Replit -- single-port entry.
#
# **Not verified against a real Replit container.** Every other
# deployment path in this repo was driven for real before being
# written down: the pm2 config was booted (33 online, 33/34 health
# 200), the gateway was proven against the live stack through one
# port. This file could not be, because there is no Replit account
# attached to this work. It is written from the documented schema and
# should be treated as a first draft that someone runs and corrects,
# not as a tested config.
#
# What IS verified is everything underneath it: `deploy/replit-boot.sh`,
# `start-ecosystem.sh`'s VACO_APPS subset, and `gateway.js` all ran
# here.
#
# ---------------------------------------------------------------------
# What Replit is good for here, and what it is not
#
# Good for: showing the whole ecosystem to somebody at a URL. That is a
# real gap -- until the gateway existed, seeing this thing run meant
# cloning the repo and booting 36 servers.
#
# Not good for: production -- though the reason narrowed on 11 Sep
# 2026, and this comment carried the old, wider claim for a day: it
# asserted that all of them were file-backed. 29 of the 34 backends are
# on Postgres when DATABASE_URL is set; 2 keep JSON files (vaco-shell,
# vaco-analytics) and 3 keep no state at all.
#
# The old sentence is described rather than quoted on purpose.
# `scripts/test/storage-backends.test.mjs` bans that phrasing outright,
# and a file that reproduces it verbatim -- even to correct it -- either
# trips the check or survives only by where a line happens to wrap.
#
# Without a database every app falls back to its file, and THAT is the
# case this warning is about: the filesystem does not survive an
# Autoscale deployment, which is ephemeral and may run more than one
# instance -- two instances would keep two divergent ledgers.
#
# With the database attached, exactly one app is safe to run twice: V3
# keeps balances as real rows and takes its locks in a fixed order. The
# other 28 hold one document each behind an optimistic version check,
# which makes a concurrent write loud rather than lost, and still does
# not make two writers work.
#
# So: use a Reserved VM, and attach the database.
#
# ---------------------------------------------------------------------

run = "bash deploy/replit-boot.sh"
entrypoint = "gateway.js"

[nix]
channel = "stable-24_05"

# The gateway is the only public listener. All 34 backends stay on
# 127.0.0.1 -- same shape as the nginx configs, which is the point.
[[ports]]
localPort = 8080
externalPort = 80

[env]
# Replit sets PORT itself; this is the fallback the gateway already
# uses. Listed so the mapping above is legible next to it.
PORT = "8080"

# Boot a subset instead of all 36 apps. Most containers will hold the
# whole thing, so leave this commented out unless yours is genuinely
# small — or unless you simply want fewer apps running while you look
# at one of them.
#
# Measured on the development machine, by PSS and confirmed against
# the memory actually freed on shutdown:
#   full stack   -- 38 processes, 0.82–0.86 GB
#   5-app subset -- 11 processes, 0.13 GB
#
# An earlier revision said 2.43 GB. That was summed RSS, which
# double-counts the pages 36 Node processes share; it overstated the
# whole ecosystem by about 3.5x.
#
# VACO_APPS = "vaco-shell v3 shield void vacay"

# -- The database -----------------------------------------------------
#
# **Attach Replit's built-in PostgreSQL.** It sets DATABASE_URL, and
# that one variable is the whole configuration -- nothing else to set,
# nothing to run by hand.
#
# 29 of the 34 backends use it: `vacon-c` loads its own 63-table world
# schema into an empty database on first boot, and 28 others keep a
# document each in a `vaco.stores` table. V3 goes further -- balances
# and transactions are real rows.
#
# This section named only `vacon-c` until 11 Sep 2026, which was true
# when written and stopped being true the day 28 more apps converted.
# `scripts/test/storage-backends.test.mjs` now reads this file too, so
# the next time that number moves, the suite says so.
#
# Without a database everything still boots and falls back to a JSON
# file per app, which Replit's filesystem keeps between runs. Two things
# behave differently when a database is attached but unreachable, and
# the difference is deliberate: the 28 converted apps REFUSE to start
# and say why, while `vacon-c` starts an EMPTY world, says so in full on
# stderr, and never saves. A simulation that can regenerate its state is
# still a working demo; a ledger reading every balance as zero is not.
#
# Secrets go in Replit's Secrets pane, NOT here -- this file is
# committed. Run `node scripts/deploy-preflight.mjs` for the required
# set — deliberately not quoted here, because a number written into a
# comment goes stale silently and this one already had. Nothing here
# invents a default for any of them:
# an app that refuses to boot without its credential is an app behaving
# correctly, and it will show as DOWN with the reason in its log.

[deployment]
run = ["bash", "deploy/replit-boot.sh"]
# Reserved VM, deliberately. See the note above about JSON file stores:
# Autoscale would give this ecosystem an ephemeral, possibly-forked
# ledger, which is the one failure mode this repo has spent the most
# effort eliminating everywhere else.
deploymentTarget = "vm"
