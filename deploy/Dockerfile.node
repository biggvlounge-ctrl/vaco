# VACO -- shared Dockerfile for every real Express backend in this
# ecosystem (~27 apps, all the same real shape: npm install + npm
# start, one PORT). Used as a single, generic build target across
# every backend service in docker-compose.yml (generated by
# deploy/generate-docker-compose.js from the same authoritative
# start-ecosystem.sh manifest as ecosystem.config.js and
# nginx-vaco.conf.example) -- one Dockerfile, not 27 near-duplicates,
# since every one of these apps really does build and run identically.
#
# Build context is the individual app directory (e.g. `./v3`), NOT the
# repo root -- docker-compose.yml sets `context: ./<app>` per service,
# so `COPY . .` below only ever sees that one app's own files.
#
# Not used for `vdp`/`venvs` (Vite frontends, no `npm start` server of
# their own) -- see Dockerfile.vite for those.

FROM node:22-alpine

WORKDIR /app

# Real dependency-layer caching: only re-runs `npm install` when
# package.json/package-lock.json actually change, not on every source
# edit.
COPY package.json package-lock.json* ./
RUN npm install --omit=dev

COPY . .

ARG PORT=8789
ENV PORT=$PORT
EXPOSE $PORT

CMD ["npm", "start"]
