# VDEX ecosystem integration configuration template.
# Copy values into your managed deployment secret/config system.
# Never commit real credentials. *_CREDENTIAL_REF must be an opaque secret-vault reference,
# not a raw API key, password, bearer token, client secret or private key.
# All base URLs must use HTTPS. Configuration alone never means connected.

VDEX_VACAY_BASE_URL=
VDEX_VACAY_CONTRACT_ID=
VDEX_VACAY_CREDENTIAL_REF=

VDEX_DREAMS_BASE_URL=
VDEX_DREAMS_CONTRACT_ID=
VDEX_DREAMS_CREDENTIAL_REF=

# VDEX_VULCAN_* removed -- "VULCAN" was a mistaken reference. VOKEN (below)
# is the real, sole entity for tokenization/credentials/trust; its
# capabilities now cover both roles under one set of credentials.

VDEX_VACA_BASE_URL=
VDEX_VACA_CONTRACT_ID=
VDEX_VACA_CREDENTIAL_REF=

VDEX_VASH_BASE_URL=
VDEX_VASH_CONTRACT_ID=
VDEX_VASH_CREDENTIAL_REF=

VDEX_VCOIN_BASE_URL=
VDEX_VCOIN_CONTRACT_ID=
VDEX_VCOIN_CREDENTIAL_REF=

VDEX_VOKEN_BASE_URL=
VDEX_VOKEN_CONTRACT_ID=
VDEX_VOKEN_CREDENTIAL_REF=

VDEX_VACON_BASE_URL=
VDEX_VACON_CONTRACT_ID=
VDEX_VACON_CREDENTIAL_REF=

VDEX_VOID_BASE_URL=
VDEX_VOID_CONTRACT_ID=
VDEX_VOID_CREDENTIAL_REF=
