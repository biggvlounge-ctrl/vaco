# Vex Business — background worker image. Same real uv workspace as
# Dockerfile.api; only the run command differs.

FROM python:3.12-slim AS base

RUN pip install --no-cache-dir uv

WORKDIR /app

COPY pyproject.toml uv.lock* ./
COPY apps/api/pyproject.toml apps/api/pyproject.toml
COPY apps/worker/pyproject.toml apps/worker/pyproject.toml
COPY config/pyproject.toml config/pyproject.toml
COPY packages/domain/pyproject.toml packages/domain/pyproject.toml
COPY packages/data/pyproject.toml packages/data/pyproject.toml
COPY packages/market/pyproject.toml packages/market/pyproject.toml
COPY packages/research/pyproject.toml packages/research/pyproject.toml
COPY packages/strategy/pyproject.toml packages/strategy/pyproject.toml
COPY packages/risk/pyproject.toml packages/risk/pyproject.toml
COPY packages/execution/pyproject.toml packages/execution/pyproject.toml
COPY packages/backtest/pyproject.toml packages/backtest/pyproject.toml
COPY packages/replay/pyproject.toml packages/replay/pyproject.toml
COPY packages/analytics/pyproject.toml packages/analytics/pyproject.toml
COPY packages/ai/pyproject.toml packages/ai/pyproject.toml

COPY . .

RUN uv sync --all-packages --no-dev

ENV PATH="/app/.venv/bin:$PATH"

CMD ["python", "-m", "worker.main"]
