# Vex Business — real environment configuration. Copy to `.env` before running
# anything. Live trading stays disabled unless BOTH
# LIVE_TRADING_ENABLED=true AND LIVE_TRADING_CONFIRMATION match exactly
# — see config/settings.py for why this is deliberately two-part.

ENVIRONMENT=development
TRADING_MODE=demo

DATABASE_URL=postgresql+psycopg://vexbusiness:vexbusiness@localhost:5432/vexbusiness
REDIS_URL=redis://localhost:6379/0

LIVE_TRADING_ENABLED=false
LIVE_TRADING_CONFIRMATION=
BROKER_ADAPTER_KIND=mock

DEFAULT_DAILY_LOSS_LIMIT=0
DEFAULT_MAXIMUM_TRADE_LOSS=0
DEFAULT_MAXIMUM_CONTRACTS=0
DEFAULT_MAXIMUM_OPEN_POSITIONS=0
